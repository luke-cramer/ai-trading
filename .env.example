# Copy to .env (gitignored). Never commit real values.
# Slack or Discord incoming-webhook URL. Alerts and the daily report post here.
# Host is auto-detected (hooks.slack.com vs discord.com). Unset = print to stdout.
ALERT_WEBHOOK_URL=
# healthchecks.io ping URL (https://hc-ping.com/<uuid>). The ingest job pings it after each success;
# no ping for 90 min = healthchecks alerts you. Only used by the GitHub workflow.
HEALTHCHECK_URL=
# Tiingo API token (free account at tiingo.com). Primary price source for build #1; unset = Yahoo (laptop only).
TIINGO_TOKEN=
